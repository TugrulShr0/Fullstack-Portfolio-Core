@model EntityLayer.Concrete.Announcement

@{
    ViewData["Title"] = "Duyuru Düzenle";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title text-warning mb-4">
                <i class="mdi mdi-lead-pencil mr-2"></i> Duyuru Düzenleme Paneli
            </h4>

            <form class="forms-sample" method="post" asp-action="EditAnnouncement">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID" />

                <div class="form-group">
                    <label class="text-muted font-weight-bold">Duyuru Başlığı</label>
                    <input type="text" class="form-control text-white" asp-for="Title" required />
                </div>

                <div class="form-group">
                    <label class="text-muted font-weight-bold">Duyuru Türü / Kategori</label>
                    <input type="text" class="form-control text-white" asp-for="Status" required />
                </div>

                <div class="form-group">
                    <label class="text-muted font-weight-bold">Duyuru İçeriği</label>
                    <textarea class="form-control text-white" asp-for="Content" rows="6" required></textarea>
                </div>

                <button type="submit" class="btn btn-warning mr-2">
                    <i class="mdi mdi-check mr-1"></i> Değişiklikleri Kaydet
                </button>
                <a href="/Announcement/Index/" class="btn btn-dark">İptal</a>
            </form>
        </div>
    </div>
</div>

@model EntityLayer.Concrete.Message

@{
    ViewData["Title"] = "ContactDetails";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title text-info mb-4">Mesaj Detayları</h4>

            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Gönderen:</div>
                <div class="col-sm-9 font-weight-bold text-white">@Model.Name</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 text-muted">E-Posta:</div>
                <div class="col-sm-9 text-primary">
                    <a href="mailto:@Model.Mail" class="text-info text-decoration-none">@Model.Mail</a>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-3 text-muted">Tarih:</div>
                <div class="col-sm-9 text-muted">@(((DateTime)Model.Date).ToString("dd.MM.yyyy HH:mm"))</div>
            </div>

            <hr style="border-color: #2c2e33;" />

            <div class="mb-3">
                <div class="text-muted mb-2 font-weight-bold">Mesaj:</div>
                <div class="p-3" style="background-color: #191c24; border: 1px solid #2c2e33; border-radius: 6px; color: #fff; min-height: 120px; line-height: 1.6;">
                    @Model.Content
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-primary mt-3">İletişim İsteklerine Dön</a>
        </div>
    </div>
</div>
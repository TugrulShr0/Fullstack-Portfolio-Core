@using EntityLayer.Concrete
@model List<WriterRole>

@{
    ViewData["Title"] = "Rol Listesi";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="card-title mb-0">
                    <i class="mdi mdi-shield-account text-primary mr-2"></i> Sistem Rol Listesi
                </h4>
                <a href="/Role/AddRole/" class="btn btn-outline-success">
                    <i class="mdi mdi-plus-circle mr-1"></i> Yeni Rol Oluştur
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover text-white">
                    <thead>
                        <tr class="text-muted">
                            <th style="width: 10%;">#</th>
                            <th style="width: 70%;">ROL ADI</th>
                            <th style="width: 20%;" class="text-center">İŞLEMLER</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            int count = 0;
                            foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <td><span class="badge badge-outline-primary">@count</span></td>
                                    <td class="font-weight-bold">
                                        <label class="badge badge-dark text-light border border-secondary px-3 py-2">
                                            <i class="mdi mdi-security mr-1"></i>@item.Name
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <a href="/Role/DeleteRole/@item.Id" onclick="return confirm('Bu rolü silmek istediğinize emin misiniz?');" class="btn btn-outline-danger btn-sm">
                                            <i class="mdi mdi-delete"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Sistemde kayıtlı rol bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <a href="/Role/UserList/" class="btn btn-outline-info mt-3">
                <i class="mdi mdi-account-group mr-1"></i> Kullanıcı Rol Atama Listesine Git
            </a>
        </div>
    </div>
</div>

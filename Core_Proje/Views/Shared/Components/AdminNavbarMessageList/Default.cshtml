@using EntityLayer.Concrete
@model List<WriterMessage>

<div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list" aria-labelledby="messageDropdown">
    <h6 class="p-3 mb-0">Son Mesajlar</h6>

    @foreach (var item in Model)
    {
        <div class="dropdown-divider"></div>
        <a class="dropdown-item preview-item" href="/AdminMessage/AdminMessageDetails/@item.WriterMessageID">
            <div class="preview-thumbnail">
                <div class="preview-icon bg-dark rounded-circle">
                    <i class="mdi mdi-email text-primary"></i>
                </div>
            </div>
            <div class="preview-item-content">
                <p class="preview-subject ellipsis mb-1">@item.SenderName bir mesaj gönderdi</p>
                <p class="text-muted mb-0"> @(((DateTime)item.Date).ToString("dd-MMM-yyyy")) </p>
            </div>
        </a>
    }

    <div class="dropdown-divider"></div>
    <a class="dropdown-item preview-item" href="/AdminMessage/ReceiverMessageList/">
        <div class="preview-thumbnail">
            <div class="preview-icon bg-dark rounded-circle">
                <i class="mdi mdi-email-open text-success"></i>
            </div>
        </div>
        <div class="preview-item-content">
            <p class="preview-subject ellipsis mb-1">Tüm Mesajları Gör</p>
        </div>
    </a>
</div>
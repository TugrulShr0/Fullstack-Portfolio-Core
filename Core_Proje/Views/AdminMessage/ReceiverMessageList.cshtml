@model List<EntityLayer.Concrete.WriterMessage>

@{
    ViewData["Title"] = "ReceiverMessageList";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yazar-Admin Gelen Kutusu</h4>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Gönderen</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Detaylar</th>
                            <th>Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#</td>
                                    <td>@item.SenderName (@item.Sender)</td>
                                    <td>@item.Subject</td>
                                    <td>@(((DateTime)item.Date).ToString("dd.MM.yyyy HH:mm"))</td>
                                    <td><a href="/AdminMessage/AdminMessageDetails/@item.WriterMessageID" class="btn btn-outline-primary btn-sm">Detay</a></td>
                                    <td><a href="/AdminMessage/AdminMessageDelete/@item.WriterMessageID" class="btn btn-outline-danger btn-sm">Sil</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Henüz gelen bir mesaj bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <a href="/AdminMessage/AdminMessageSend/" class="btn btn-outline-info mt-3">Yeni Mesaj Oluştur</a>
        </div>
    </div>
</div>
@model EntityLayer.Concrete.About

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}

@using (Html.BeginForm("Index", "About", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="card-description"> Hakkımda Düzenleme Paneli </p>

                @* Güncellemede ID ve mevcut resmin kaybolmaması için gizli alanlar *@
                @Html.HiddenFor(x => x.AboutID)
                @Html.HiddenFor(x => x.ImageUrl)

                <div class="form-group">
                    <label>Başlık</label>
                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Yaş</label>
                    @Html.TextBoxFor(x => x.Age, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Mail</label>
                    @Html.TextBoxFor(x => x.Mail, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Adres</label>
                    @Html.TextBoxFor(x => x.Address, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Telefon</label>
                    @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label>Profil / Hakkımda Görseli (Değiştirmek istemiyorsanız boş bırakın)</label>
                    @if (Model != null && !string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Mevcut Profil Görseli" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; display: block;" />
                        </div>
                    }
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                </div>

                <div class="form-group">
                    <label>Açıklama</label>
                    @Html.TextAreaFor(x => x.Descrition, 6, 3, new { @class = "form-control" })
                </div>

                <button type="submit" class="btn btn-primary mr-2">Kaydet</button>
                <a href="/About/Index/" class="btn btn-dark">İptal</a>
            </div>
        </div>
    </div>
}